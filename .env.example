# ==============================================================================
# TBB WORKSPACE V2 — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in the values from your Supabase project.
# .env is git-ignored. Never commit real values.
#
# Only these two values belong here. They are PUBLIC browser values.
# NEVER put the service_role / secret key or the database password in a
# VITE_ variable: Vite bundles every VITE_ variable into the browser.
# ==============================================================================

# Supabase Dashboard -> Project Settings -> API -> Project URL
# e.g. https://<project-ref>.supabase.co  (local CLI stack: http://127.0.0.1:54321)
VITE_SUPABASE_URL=

# Supabase Dashboard -> Project Settings -> API Keys
# Use the "Publishable key" (sb_publishable_...) or the legacy "anon" key.
# Row Level Security protects the data, so this key is safe to expose.
VITE_SUPABASE_ANON_KEY=
